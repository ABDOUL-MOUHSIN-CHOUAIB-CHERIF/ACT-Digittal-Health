<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.clinic.controllers.LoginController"
            prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: #f8f9fa;">

    <!-- Main Container -->
    <HBox prefHeight="700.0" prefWidth="1200.0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Left Side - Hospital Branding -->
        <VBox alignment="CENTER" prefWidth="600"
              style="-fx-background-color: linear-gradient(to bottom right, #1a73e8, #0d47a1);">

            <!-- Hospital Icon Container -->
            <StackPane>
                <Circle radius="80" fill="white" opacity="0.2"/>
                <Circle radius="60" fill="white" opacity="0.3"/>

                <!-- Hospital Icon (Using Unicode + Styling) -->
                <VBox alignment="CENTER" spacing="5">
                    <Label text="🏥"
                           style="-fx-font-size: 48px; -fx-padding: 0;"/>
                    <Label text="ACT Digital Health"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
                    <Label text="Clinic Management System"
                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 16px; -fx-padding: 5 0 0 0;"/>
                </VBox>
            </StackPane>

            <!-- Additional Branding Text -->
            <VBox alignment="CENTER" spacing="15" style="-fx-padding: 50 0 0 0;">
                <Label text="Transforming Healthcare"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Through Technology"
                       style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px;"/>


            </VBox>

        </VBox>

        <!-- Right Side - Login Form -->
        <VBox alignment="CENTER" prefWidth="600"
              style="-fx-background-color: white; -fx-padding: 60;">

            <!-- Login Header -->
            <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 40 0;">
                <Label text="Welcome Back"
                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
                <Label text="Sign in to your account"
                       style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
            </VBox>

            <!-- Login Form -->
            <VBox alignment="CENTER_LEFT" spacing="25" prefWidth="400">

                <!-- Username Field -->
                <VBox spacing="8">
                    <Label text="Username"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <TextField fx:id="usernameField"
                               promptText="Enter your username"
                               style="-fx-pref-height: 50px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 0 15;"/>
                </VBox>

                <!-- Password Field -->
                <VBox spacing="8">
                    <Label text="Password"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="Enter your password"
                                   style="-fx-pref-height: 50px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 0 15;"/>
                </VBox>

                <!-- Remember Me & Forgot Password -->
                <HBox alignment="CENTER_LEFT" spacing="120">
                    <CheckBox text="Remember me"
                              style="-fx-text-fill: #666; -fx-font-size: 14px;"/>
                    <Button text="Forgot Password?"
                            style="-fx-background-color: transparent; -fx-text-fill: #1a73e8; -fx-font-size: 14px; -fx-padding: 0; -fx-cursor: hand;"/>
                </HBox>

                <!-- Login Button -->
                <Button fx:id="loginButton" text="SIGN IN"
                        onAction="#handleLogin"
                        style="-fx-pref-height: 50px; -fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 8; -fx-cursor: hand;"
                        prefWidth="400"/>

                <!-- Alternative Login Options -->
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20 0 0 0;">
                    <Label text="or continue with"
                           style="-fx-text-fill: #666; -fx-font-size: 14px;"/>

                    <HBox alignment="CENTER" spacing="15">
                        <Button text="Google"
                                style="-fx-pref-height: 40px; -fx-pref-width: 120px; -fx-background-color: #f8f9fa; -fx-text-fill: #333; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Button text="LinkedIn"
                                style="-fx-pref-height: 40px; -fx-pref-width: 120px; -fx-background-color: #f8f9fa; -fx-text-fill: #333; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                    </HBox>
                </VBox>

                <!-- Sign Up Link -->
                <HBox alignment="CENTER" style="-fx-padding: 30 0 0 0;">
                    <Label text="Don't have an account? "
                           style="-fx-text-fill: #666; -fx-font-size: 14px;"/>
                    <Button text="Sign up"
                            style="-fx-background-color: transparent; -fx-text-fill: #1a73e8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 0 0 0 5; -fx-cursor: hand;"/>
                </HBox>

            </VBox>

        </VBox>

    </HBox>

</AnchorPane>