<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<?import java.lang.String?>
<AnchorPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clinic.controllers.LoginController">

    <!-- Main Container -->
    <HBox prefHeight="700.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- Left Side - Hospital Branding -->
        <VBox alignment="CENTER" prefWidth="600" style="-fx-background-color: linear-gradient(to bottom right, #1a73e8, #0d47a1);">

            <!-- Hospital Icon Container -->
            <StackPane>
                <Circle fill="white" opacity="0.2" radius="80" />
                <Circle fill="white" opacity="0.3" radius="60" />

                <!-- Hospital Icon (Using Unicode + Styling) -->
                <VBox alignment="CENTER" spacing="5">
                    <Label style="-fx-font-size: 48px; -fx-padding: 0;" text="🏥" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" text="ACT Digital Health" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 16px; -fx-padding: 5 0 0 0;" text="Clinic Management System" />
                </VBox>
            </StackPane>

            <!-- Additional Branding Text -->
            <VBox alignment="CENTER" spacing="15" style="-fx-padding: 50 0 0 0;">
                <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Transforming Healthcare" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px;" text="Through Technology" />


            </VBox>

        </VBox>

        <!-- Right Side - Login Form -->
        <VBox alignment="CENTER" prefWidth="600" style="-fx-background-color: white; -fx-padding: 60;">

            <!-- Login Header -->
            <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 40 0;">
                <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;" text="Welcome Back" />
                <Label style="-fx-font-size: 16px; -fx-text-fill: #666;" text="Log in to your account" />
            </VBox>

            <!-- Login Form -->
            <VBox alignment="CENTER_LEFT" prefWidth="400" spacing="25">

                <!-- Username Field -->
                <VBox spacing="8">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Username" />
                    <TextField fx:id="usernameField" promptText="Enter your username(only the first name)" style="-fx-pref-height: 50px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 0 15;" />
                </VBox>

                <!-- Password Field -->
                <VBox spacing="8">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Password" />
                    <PasswordField fx:id="passwordField" promptText="Enter your password" style="-fx-pref-height: 50px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 0 15;" />
                </VBox>

                <!-- Role Selection Dropdown -->
                <VBox spacing="8">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Role" />
                    <ComboBox fx:id="roleComboBox" promptText="Select your role" style="-fx-pref-height: 50px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 0 15;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="DOCTOR" />
                                <String fx:value="RECEPTIONIST" />
                                <String fx:value="PHARMACIST" />
                                <String fx:value="ADMIN" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <!-- Login Button -->
                <Button fx:id="loginButton" onAction="#handleLogin" prefWidth="400" style="-fx-pref-height: 50px; -fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 8; -fx-cursor: hand;" text="LOG IN">
                    <VBox.margin>
                        <Insets left="35.0" />
                    </VBox.margin>
                </Button>

                <!-- Alternative Login Options -->
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20 0 0 0;">
                    <HBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="30.0" prefWidth="250.0">
                        <children>
                            <Line endX="80.62620544433594" endY="-0.6212860345840454" startX="-100.0">
                                <HBox.margin>
                                    <Insets left="20.0" top="10.0" />
                                </HBox.margin>
                            </Line>
                            <Label style="-fx-text-fill: #666; -fx-font-size: 14px;" text="OR">
                                <HBox.margin>
                                    <Insets left="5.0" />
                                </HBox.margin>
                            </Label>
                            <Line endX="100.0" layoutX="111.0" layoutY="11.0" startX="-100.0">
                                <HBox.margin>
                                    <Insets left="10.0" top="10.0" />
                                </HBox.margin>
                            </Line>
                        </children>
                        <padding>
                            <Insets top="10.0" />
                        </padding>
                        <VBox.margin>
                            <Insets left="20.0" right="20.0" />
                        </VBox.margin>
                    </HBox>

                    <HBox alignment="CENTER" spacing="15">
                        <children>

                            <!-- Sign Up Link -->
                            <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="400.0" style="-fx-padding: 30 0 0 0;">
                                <Label style="-fx-text-fill: #666; -fx-font-size: 14px;" text="Don't have an account? ">
                                    <HBox.margin>
                                        <Insets bottom="30.0" left="-150.0" />
                                    </HBox.margin>
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <Button minHeight="-Infinity" minWidth="-Infinity" onAction="#handleSignIn" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 0 0 0 5; -fx-cursor: hand; -fx-background-radius: 8;" styleClass="signup" stylesheets="@../CSS/signIn.css" text="SIGN UP">
                                    <HBox.margin>
                                        <Insets bottom="25.0" left="20.0" right="-140.0" />
                                    </HBox.margin>
                                </Button>
                            </HBox>
                        </children>
                    </HBox>
                    <VBox.margin>
                        <Insets top="-10.0" />
                    </VBox.margin>
                </VBox>

            </VBox>

        </VBox>

    </HBox>

</AnchorPane>